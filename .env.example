# Woodpecker Server Configuration

# The URL where Woodpecker will be accessible (e.g., https://ci.example.com)
WOODPECKER_HOST=http://localhost:8000

# GitHub OAuth Application credentials
# Create at: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Authorization callback URL: ${WOODPECKER_HOST}/authorize
WOODPECKER_GITHUB_CLIENT=your-github-client-id
WOODPECKER_GITHUB_SECRET=your-github-client-secret

WOODPECKER_AGENT_SECRET=your-random-secret-here

WOODPECKER_ADMIN=your-github-username

# Allow open registration (set to false to restrict access)
WOODPECKER_OPEN=true

WOODPECKER_MAX_WORKFLOWS=2
